{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comsflow-wms-v2-app-v-n-n---kho",
  "main": "src/server/worker.ts",
  "keep_vars": true,
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8c06ca81531944b784e94ae3f3c404b4",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "vars": {
    "APP_ORIGIN": "https://comsflow-wms-v2-app-v-n-n---kho.comsflow-apps.workers.dev",
    "DB_MAX_CONNECTIONS": "1",
    "STORAGE_BUCKET": "comsflow-private",
    "SUPABASE_URL": "https://lyeyjfvxmqruszgfrjze.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_pCHyGxyD__Am4ZYfRQJOmw_ENNLAV_f",
  },
}
