{
  "name": "comsflow-wms-supabase",
  "version": "2.0.0",
  "description": "ComsFlow WMS \u2014 Cloudflare web, Supabase PostgreSQL/Storage/Auth, isolated background workers",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "build:worker": "node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts --demo",
    "db:admin": "node --env-file-if-exists=.env.local --import tsx scripts/admin.ts",
    "storage:setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup-storage.ts",
    "worker:dev": "node --env-file-if-exists=.env.local --import tsx src/worker/main.ts",
    "worker:start": "node .worker/main.mjs",
    "test": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "format": "prettier --write src scripts tests migrations docs *.ts *.json *.jsonc *.mjs README.md",
    "db:migrate-data": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-data.ts",
    "db:migrate-auth": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-auth.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0",
    "busboy": "^1.6.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.59.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "saxes": "5.0.1",
    "unpdf": "^1.9.0",
    "unzipper": "^0.12.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.1.17",
    "@types/busboy": "^1.5.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^5.1.0",
    "bcryptjs": "^3.0.3",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.50.0"
  },
  "private": true,
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
