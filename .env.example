# Public project URL supplied by the owner. Never commit actual secret values.
# Server only: Supabase Connect > Session pooler or Transaction pooler, SSL required.
DATABASE_URL=postgresql://postgres.lyeyjfvxmqruszgfrjze:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
SUPABASE_URL=https://lyeyjfvxmqruszgfrjze.supabase.co
# Publishable/anon key is public. Used for browser signed uploads and login.
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Secret, server ONLY. Never VITE_ or browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
STORAGE_BUCKET=comsflow-private
APP_ORIGIN=https://YOUR_NEW_APP.workers.dev
DB_MAX_CONNECTIONS=1
# Optional first-admin setup, >=32 random characters. Remove after setup.
# For data migration, leave unset until old users have been imported.
# SETUP_TOKEN=
# Optional account creation through CLI; never put actual passwords in Git/chat.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
# Data migration: source must be the OLD read-only connection, target NEW project.
# SOURCE_DATABASE_URL=
# MIGRATION_TARGET_CONFIRM=POOLER_HOST/postgres
# MIGRATION_SKIP_DEFAULTS=1
# Dedicated local disposable tests only:
# TEST_DATABASE_URL=postgresql://comsflow:comsflow_local_dev@127.0.0.1:5432/comsflow_v2_test
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
